#!/usr/bin/env bash
set -Eeuo pipefail

readonly DOCKER_USER="dockerroot"
readonly DOCKER_HOME="/home/${DOCKER_USER}"
readonly DOCKER_UID="$(id -u "$DOCKER_USER")"
readonly DOCKER_SOCKET="/run/user/${DOCKER_UID}/docker.sock"

# Определяем расположение Docker CLI.
DOCKER_BIN="$(command -v docker || true)"

if [[ -z "$DOCKER_BIN" && -x "${DOCKER_HOME}/bin/docker" ]]; then
    DOCKER_BIN="${DOCKER_HOME}/bin/docker"
fi

if [[ -z "$DOCKER_BIN" || ! -x "$DOCKER_BIN" ]]; then
    echo "Docker CLI not found." >&2
    exit 127
fi

# labctl должен запускаться от имени dockerroot.
if [[ "$(id -un)" != "$DOCKER_USER" ]]; then
    echo "labctl must run as ${DOCKER_USER}." >&2
    exit 1
fi

export HOME="$DOCKER_HOME"
export DOCKER_HOST="unix://${DOCKER_SOCKET}"

if [[ ! -S "$DOCKER_SOCKET" ]]; then
    echo "Docker socket not found: ${DOCKER_SOCKET}" >&2
    exit 1
fi

case "${1:-}" in
status)
    [[ $# -eq 1 ]] || {
        echo "Usage: labctl status" >&2
        exit 2
    }

    exec "$DOCKER_BIN" ps \
        --filter name=lab-client \
        --filter name=lab-filter \
        --filter name=lab-server \
        --format 'table {{.Names}}\t{{.Status}}'
    ;;

shell)
    [[ $# -eq 2 ]] || {
        echo "Usage: labctl shell client|filter|server" >&2
        exit 2
    }

    case "$2" in
    client) container="lab-client" ;;
    filter) container="lab-filter" ;;
    server) container="lab-server" ;;
    *)
        echo "Unknown lab node." >&2
        exit 2
        ;;
    esac

    if ! "$DOCKER_BIN" inspect "$container" >/dev/null 2>&1; then
        echo "Container not found: ${container}" >&2
        exit 1
    fi

    if ! "$DOCKER_BIN" inspect \
        --format '{{.State.Running}}' "$container" | grep -qx true; then
        echo "Container is not running: ${container}" >&2
        exit 1
    fi

    # Используем /workspace, только если он реально существует.
    workdir="/"
    if "$DOCKER_BIN" exec "$container" test -d /workspace; then
        workdir="/workspace"
    fi

    exec "$DOCKER_BIN" exec -it \
        --user 0 \
        --workdir "$workdir" \
        "$container" /bin/sh
    ;;

*)
    echo "Usage: labctl status | shell client|filter|server" >&2
    exit 2
    ;;
esac
