
#!/usr/bin/env bash
set -Eeuo pipefail

readonly LABCTL="/usr/local/sbin/labctl"
readonly SUDO="/usr/bin/sudo"

run_labctl() {
    # Не завершаем меню при ошибке labctl или sudo.
    if "$SUDO" -n -u dockerroot "$LABCTL" "$@"; then
        return 0
    else
        rc=$?
        echo "Lab command failed (exit code: ${rc})." >&2
        return "$rc"
    fi
}

choose_node() {
    local choice

    while true; do
        echo
        echo "Network research lab"
        echo "1) client"
        echo "2) filter"
        echo "3) server"
        echo "4) status"
        echo "q) quit"

        if ! read -r -p "Select: " choice; then
            # EOF: например, клиент закрыл stdin.
            echo
            exit 0
        fi

        case "$choice" in
            1)
                run_labctl shell client || true
                ;;
            2)
                run_labctl shell filter || true
                ;;
            3)
                run_labctl shell server || true
                ;;
            4)
                run_labctl status || true
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo "Invalid selection." >&2
                ;;
        esac
    done
}

original="${SSH_ORIGINAL_COMMAND:-}"

# Обычный интерактивный SSH: показываем меню.
if [[ -z "$original" ]]; then
    choose_node
fi

# SSH с удалённой командой: разрешаем только явно перечисленные действия.
case "$original" in
    "shell client")
        exec "$SUDO" -n -u dockerroot "$LABCTL" shell client
        ;;
    "shell filter")
        exec "$SUDO" -n -u dockerroot "$LABCTL" shell filter
        ;;
    "shell server")
        exec "$SUDO" -n -u dockerroot "$LABCTL" shell server
        ;;
    "status")
        exec "$SUDO" -n -u dockerroot "$LABCTL" status
        ;;
    *)
        echo "Command not allowed by the lab gateway." >&2
        exit 126
        ;;
esac

